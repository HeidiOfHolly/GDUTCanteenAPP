<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditText
        android:id="@+id/register_user_name"
        android:layout_width="290dp"
        android:layout_height="50dp"
        android:background="@drawable/frame"
        android:layout_marginTop="20dp"
        android:hint="   请输入昵称："
        android:paddingStart="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />
    <EditText
        android:id="@+id/register_user_account"
        android:layout_width="290dp"
        android:layout_height="50dp"
        android:paddingStart="5dp"
        android:background="@drawable/frame"
        android:hint="   请输入学号："
        android:inputType="number"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/register_user_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />
    <EditText
        android:id="@+id/register_password"
        android:layout_width="290dp"
        android:layout_height="50dp"
        android:paddingStart="5dp"
        android:background="@drawable/frame"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/register_user_account"
        android:layout_marginTop="8dp"
        android:hint="   请输入密码："
        android:inputType="textPassword" />
    <EditText
        android:id="@+id/register_password_repeat"
        android:layout_width="290dp"
        android:layout_height="50dp"
        android:paddingStart="5dp"
        android:background="@drawable/frame"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/register_password"
        android:layout_marginTop="8dp"
        android:hint="   请再次输入密码："
        android:inputType="textPassword" />
    <TextView
        android:id="@+id/login_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/register_password_repeat"
        android:layout_marginTop="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:text="已有账号？点击登录"
        android:textSize="18dp"
        android:clickable="true"
        android:focusable="true"/>
    <Button
        android:id="@+id/register_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_text"
        android:layout_marginTop="5dp"
        android:text="注册" />


</androidx.constraintlayout.widget.ConstraintLayout>