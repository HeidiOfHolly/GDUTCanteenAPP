<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/iv_smile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/smile"
        android:layout_marginTop="150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />
    <EditText
        android:id="@+id/et_student_no"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/frame"
        android:layout_marginTop="10dp"
        android:hint="  请输入学号："
        app:layout_constraintTop_toBottomOf="@+id/iv_smile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />
    <EditText
        android:id="@+id/et_password"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/frame"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_student_no"
        android:layout_marginTop="8dp"
        android:hint="  请输入密码：" />
    <TextView
        android:id="@+id/tv_register_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/et_password"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:text="还没账号？点击注册"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:clickable="true"
        android:focusable="true"/>
    <!-- 如果少了最后一行代码，这个控件就不能被点击 -->
    <CheckBox
        android:id="@+id/cb_remember_pass"
        app:layout_constraintTop_toTopOf="@+id/tv_remember_pass"
        app:layout_constraintRight_toLeftOf="@+id/tv_remember_pass"
        android:theme="@style/CustomCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tv_remember_pass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_register_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:text="记住密码"
        android:textSize="18sp"/>
    <Button
        android:id="@+id/bn_login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_remember_pass"
        android:text="登录" />


</androidx.constraintlayout.widget.ConstraintLayout>